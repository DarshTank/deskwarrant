# DeskWarrant Console — environment (build plan §12)
# Copy to `.env` and fill in. Never commit `.env`.

# ---------- Database (Supabase Postgres) ----------
# Both strings come from: Supabase Dashboard > Project > Connect.
# They are NOT interchangeable -- see the two notes below.
#
# DATABASE_URL: Supavisor TRANSACTION pooler, port 6543. Used at runtime by
# every serverless function.
#   `pgbouncer=true` is REQUIRED, not optional. Transaction mode cannot hold
#   prepared statements, which Prisma creates by default; without this flag you
#   get sporadic "prepared statement s0 already exists" errors under load.
#   `connection_limit` sizes Prisma's pool INSIDE one function process. Do not
#   set it to 1: Vercel's Fluid compute handles many concurrent requests in a
#   single Node process sharing one PrismaClient, so a pool of 1 serialises
#   them and anything that waits longer than `pool_timeout` (10s) dies with
#   P2024 -- a database outage that is not a database outage. 5-10 is right for
#   Supavisor's transaction pooler.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Keep the Supabase project and the Vercel functions in the SAME region. Every
# query is a round trip, and the poll route makes several per call, per device,
# every two seconds -- crossing a continent turns that into seconds of held
# connection. `console/vercel.json` pins functions to bom1 (Mumbai) to match an
# ap-south-1 Supabase project; change BOTH together or neither.

# DIRECT_URL: port 5432, used by `prisma migrate` only. Migrations need session
# state (advisory locks, DDL transactions) that the transaction pooler drops.
#   Use the SESSION POOLER host below -- it resolves over IPv4.
#   The raw direct host (db.PROJECTREF.supabase.co:5432) is IPv6-ONLY unless you
#   buy the IPv4 add-on, so on most laptops and CI runners it fails with
#   ENETUNREACH / "Can't reach database server". If your network has IPv6, the
#   raw direct host works too and is marginally faster for migrations.
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------- Auth.js ----------
# Generate with: npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=""
# Local dev: http://localhost:3000   Production: https://<app>.vercel.app
AUTH_URL="http://localhost:3000"
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web).
# Authorized redirect URI must be: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Assistant (Groq) ----------
# https://console.groq.com/keys
GROQ_API_KEY=""
# Text-only tool-calling model. No vision model is used; no image ever leaves the PC.
GROQ_MODEL="openai/gpt-oss-120b"

# ---------- Live view (Cloudflare Tunnel, auto-provisioned) ----------
# The console creates one tunnel and one subdomain per paired PC through the
# Cloudflare API. Users need no Cloudflare account and no domain of their own.
#
# This token can edit DNS across the zone, so it lives HERE ONLY and is never
# sent to an agent. Each PC receives a tunnel token scoped to its own tunnel.
#
# Create at: Cloudflare Dashboard > Manage Account > API Tokens > Create Token
#   > Create Custom Token, with these two permissions:
#     Account | Cloudflare Tunnel | Edit
#     Zone    | DNS               | Edit   (limited to your tunnel domain)
CLOUDFLARE_API_TOKEN=""
# Dashboard > any domain > Overview > right sidebar > Account ID / Zone ID
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ZONE_ID=""
# Devices get pc-xxxxxxxx.<this>. Must be the domain the Zone ID refers to.
TUNNEL_BASE_DOMAIN="example.com"
# Encrypts tunnel tokens at rest. 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TUNNEL_ENCRYPTION_KEY=""

# Leave the five above blank to run without live view: Ask, Act, and Watch
# work fine, and pairing succeeds with live view reported as unavailable.

# ---------- Agent download ----------
# The GitHub repo whose Releases hold the built agent. /api/download redirects
# to its newest release asset, so the repo must be PUBLIC — private release
# assets require authentication and a new user's browser has none.
# Defaults to DarshTank/deskwarrant if unset.
AGENT_REPO="DarshTank/deskwarrant"

# ---------- Web Push (VAPID) ----------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Must equal VAPID_PUBLIC_KEY. Exposed to the browser to subscribe for push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
