# DeskWarrant Console — environment (build plan §12)
# Copy to `.env` and fill in. Never commit `.env`.

# ---------- Database (Neon Postgres) ----------
# DATABASE_URL: the POOLED endpoint. Its hostname MUST contain "-pooler".
# Used at runtime by every serverless function.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: the DIRECT (non-pooled) endpoint. Used by `prisma migrate` only.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------- Auth.js ----------
# Generate with: npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET=""
# Local dev: http://localhost:3000   Production: https://<app>.vercel.app
AUTH_URL="http://localhost:3000"
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web).
# Authorized redirect URI must be: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Assistant (Groq) ----------
# https://console.groq.com/keys
GROQ_API_KEY=""
# Text-only tool-calling model. No vision model is used; no image ever leaves the PC.
GROQ_MODEL="openai/gpt-oss-120b"

# ---------- Live view (Cloudflare Tunnel, auto-provisioned) ----------
# The console creates one tunnel and one subdomain per paired PC through the
# Cloudflare API. Users need no Cloudflare account and no domain of their own.
#
# This token can edit DNS across the zone, so it lives HERE ONLY and is never
# sent to an agent. Each PC receives a tunnel token scoped to its own tunnel.
#
# Create at: Cloudflare Dashboard > Manage Account > API Tokens > Create Token
#   > Create Custom Token, with these two permissions:
#     Account | Cloudflare Tunnel | Edit
#     Zone    | DNS               | Edit   (limited to your tunnel domain)
CLOUDFLARE_API_TOKEN=""
# Dashboard > any domain > Overview > right sidebar > Account ID / Zone ID
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ZONE_ID=""
# Devices get pc-xxxxxxxx.<this>. Must be the domain the Zone ID refers to.
TUNNEL_BASE_DOMAIN="example.com"
# Encrypts tunnel tokens at rest. 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TUNNEL_ENCRYPTION_KEY=""

# Leave the five above blank to run without live view: Ask, Act, and Watch
# work fine, and pairing succeeds with live view reported as unavailable.

# ---------- Agent download ----------
# The GitHub repo whose Releases hold the built agent. /api/download redirects
# to its newest release asset, so the repo must be PUBLIC — private release
# assets require authentication and a new user's browser has none.
# Defaults to DarshTank/deskwarrant if unset.
AGENT_REPO="DarshTank/deskwarrant"

# ---------- Web Push (VAPID) ----------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Must equal VAPID_PUBLIC_KEY. Exposed to the browser to subscribe for push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
